# ── Auth0 (Single Page Application) ─────────────────────────────────────────
VITE_AUTH0_DOMAIN=yourapp.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# ── Firebase ─────────────────────────────────────────────────────────────────
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=yourproject.firebaseapp.com
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# ── OpenRouteService (safe-route suggestions) ────────────────────────────────
VITE_ORS_KEY=

# ── Google Gemini AI (direction analysis) ─────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ── Guest mode ───────────────────────────────────────────────────────────────
# Afișează butonul "Continuă fără cont" pe ecranul de login.
# Pune true în development, false sau șterge linia înainte de producție.
VITE_GUEST_ENABLED=false
